# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

# Application port
PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3306/support_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_ROOT_PASSWORD=your_root_password_here
